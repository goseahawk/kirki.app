# x86-64 Linux programs through Apple's Rosetta, when the kirki Mac app shares it.
[Unit]
Description=kirki: run x86-64 programs with Rosetta
After=local-fs.target systemd-binfmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/kirk-vm-rosetta

[Install]
WantedBy=multi-user.target
