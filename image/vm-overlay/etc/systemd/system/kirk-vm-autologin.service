# After first-start setup has made your account: log it in by itself (see /usr/local/bin/kirk-vm-autologin).
[Unit]
Description=kirki: log in automatically in the kirki Mac app
ConditionPathExists=/var/lib/kirkus/setup-done
ConditionPathExists=!/var/lib/kirki-vm/autologin-set
After=kirk-setup.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kirk-vm-autologin

[Install]
WantedBy=multi-user.target
