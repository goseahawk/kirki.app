#!/bin/bash
# kirk-vm-agent: kirki's side of its connection to the kirki Mac app, over a virtio console port
# (/dev/virtio-ports/org.kirki.control). One message per line, words separated by spaces.
#
# From the Mac app:
#   hostinfo KEY=VALUE...  the Mac's keyboard, time zone, model and screen, saved in /run/kirki/host.env
#                          for the first-start setup and the About page (values are %-encoded)
#   time SECONDS           set the clock: after the Mac wakes from sleep, the VM's clock is behind
#   shutdown | reboot      shut down or restart kirki the way Shut Down in kirki does: Plasma closes
#                          the apps first (they can ask about unsaved work), then the system stops
#   status                 answered with "status KEY=VALUE..." (for the app's log and for testing)
#   ping                   answered with "pong"
#   journal UNIT           the last messages of one of kirki's own services (kirk-*), each sent as
#                          "log UNIT: TEXT", then "log-end" (for the app's log when something fails)
# To the Mac app:
#   ready VERSION          when this starts (the app answers with hostinfo and time)
#   power poweroff|reboot  at the very end of shutting down (sent by kirk-vm-power, not from here)
#
# Started by udev as soon as the port appears (kirk-vm-agent.service); restarted if it stops.
# Logs: journalctl -u kirk-vm-agent
set -u
PORT=${KIRK_VM_PORT:-/dev/virtio-ports/org.kirki.control}
STATE=${KIRK_VM_STATE:-/run/kirki}
VERSION=1

[[ -e $PORT ]] || { echo "No $PORT: kirki isn't running in the kirki Mac app."; exit 0; }
mkdir -p "$STATE"
# The Mac app may not be listening yet; a failed write must not end this script.
trap '' PIPE

send() { printf '%s\n' "$*" >&3 2>/dev/null || true; }

# hostinfo values: %XX decoded, then only characters that are safe in a KEY=VALUE file kept
decode() {
  printf '%b' "${1//%/\\x}" | tr -cd 'A-Za-z0-9 ._,:/+()@-' | cut -c1-120
}

save_hostinfo() {
  local kv key out=$STATE/host.env.new
  : > "$out"
  for kv in "$@"; do
    [[ $kv == *=* ]] || continue
    key=${kv%%=*}
    [[ $key =~ ^[A-Z][A-Z0-9_]{0,31}$ ]] || continue
    printf '%s=%s\n' "$key" "$(decode "${kv#*=}")" >> "$out"
  done
  chmod 644 "$out"
  mv -f "$out" "$STATE/host.env"
  echo "Mac settings: $(tr '\n' ' ' < "$STATE/host.env")"
}

set_time() {
  local t=$1 before
  [[ $t =~ ^[0-9]{9,11}(\.[0-9]{1,9})?$ ]] || { echo "Ignoring a bad time: $t"; return; }
  before=$(date +%s)
  date -s "@$t" >/dev/null && echo "Clock set from the Mac ($(( ${t%.*} - before )) s)."
}

# Close the Plasma session's apps (they can still ask about unsaved work), then stop the system.
do_shutdown() {
  local action=$1 method=logoutAndShutdown sid type cls user uid asked=no
  [[ $action == reboot ]] && method=logoutAndReboot
  for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null)
    cls=$(loginctl show-session "$sid" -p Class --value 2>/dev/null)
    [[ $cls == user && ( $type == wayland || $type == x11 ) ]] || continue
    user=$(loginctl show-session "$sid" -p Name --value 2>/dev/null)
    uid=$(id -u "$user" 2>/dev/null) || continue
    if runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
         dbus-send --session --type=method_call --dest=org.kde.Shutdown /Shutdown \
         "org.kde.Shutdown.$method" 2>/dev/null; then
      asked=yes
      echo "Asked $user's Plasma session to $action."
    fi
  done
  # Plasma stops the system itself once its apps have closed; if it hasn't after 30 seconds (an app
  # is still asking, or there's no Plasma session, as during first-start setup), stop it anyway.
  [[ $asked == yes ]] && sleep 30
  echo "Stopping the system ($action)."
  systemctl "$action" --check-inhibitors=no
}

ui_state() {
  if pgrep -x calamares >/dev/null; then echo setup
  elif pgrep -x plasmashell >/dev/null; then echo desktop
  elif pgrep -f sddm-greeter >/dev/null; then echo login
  else echo starting; fi
}

status() {
  local root failed snd=no ros=no setup=no
  root=$(findmnt -bno SIZE / 2>/dev/null | head -1)
  failed=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd, -)
  grep -qi virtio /proc/asound/cards 2>/dev/null && snd=yes
  [[ -e /proc/sys/fs/binfmt_misc/rosetta ]] && ros=yes
  [[ -e /var/lib/kirkus/setup-done ]] && setup=yes
  send "status agent=$VERSION kernel=$(uname -r) root_bytes=${root:-0} sound=$snd rosetta=$ros setup_done=$setup ui=$(ui_state) failed=${failed:-none}"
}

journal() {
  local unit=$1 l
  if [[ $unit =~ ^kirk-[a-z0-9-]+$ ]]; then
    while IFS= read -r l; do send "log $unit: ${l:0:300}"; done \
      < <(journalctl -b -u "$unit.service" -n 80 --no-pager -o cat 2>&1
          [[ -r /var/log/$unit.log ]] && tail -n 120 "/var/log/$unit.log")
  fi
  send "log-end"
}

while true; do
  if ! exec 3<>"$PORT"; then sleep 2; continue; fi
  send "ready $VERSION"
  while IFS= read -r line <&3; do
    line=${line%$'\r'}
    read -r cmd args <<<"$line"
    case ${cmd:-} in
      hostinfo) read -ra kvs <<<"$args"; save_hostinfo "${kvs[@]}" ;;
      time)     set_time "$args" ;;
      shutdown) do_shutdown poweroff & ;;
      reboot)   do_shutdown reboot & ;;
      status)   status ;;
      ping)     send pong ;;
      journal)  journal "$args" ;;
      "")       ;;
      *)        echo "Unknown message from the Mac app: ${cmd:0:40}" ;;
    esac
  done
  # The Mac app isn't connected (or let go of the port): wait, then say hello again.
  exec 3>&-
  sleep 2
done
