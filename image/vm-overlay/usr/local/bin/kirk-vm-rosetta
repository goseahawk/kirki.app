#!/bin/bash
# Lets kirki run programs made for Intel and AMD computers (x86-64 Linux), with Apple's Rosetta, when
# the kirki Mac app shares it (a virtiofs share called "rosetta"; see the app's settings). Rosetta runs
# x86-64 programs as they start, much faster than an emulator.
#
# Apps from Flathub that are only made for x86-64 can then be installed with, for example:
#   flatpak install --arch=x86_64 flathub com.example.App
#
# Logs: journalctl -u kirk-vm-rosetta
set -u
MNT=/run/rosetta
REG=/proc/sys/fs/binfmt_misc

mkdir -p "$MNT"
if ! mountpoint -q "$MNT" && ! mount -t virtiofs rosetta "$MNT" 2>/dev/null; then
  echo "Rosetta isn't shared with kirki (turn it on in the kirki app's settings)."
  exit 0
fi
[[ -x $MNT/rosetta ]] || { echo "No Rosetta program in the share."; exit 0; }
mountpoint -q "$REG" || mount -t binfmt_misc binfmt_misc "$REG"
[[ -e $REG/rosetta ]] && { echo "Rosetta is already set up."; exit 0; }
# x86-64 ELF programs go to Rosetta. F: Rosetta is opened now, so it works inside containers and
# Flatpak's sandbox too; C: set-user-ID programs keep working. (The values from Apple's instructions.)
# The \x escapes are for the kernel to read, so echo must pass them on as they are.
# shellcheck disable=SC2028
echo ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/run/rosetta/rosetta:CF' > "$REG/register"
echo "Rosetta is set up: x86-64 Linux programs run."
