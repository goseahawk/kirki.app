#!/bin/bash
# Logs your kirki account in by itself, so the kirki Mac app opens straight onto your desktop: to get
# here you've already logged in on the Mac (as the "kirki" login, or your own). Set up once, after
# the first-start setup has made the account. To get the login screen back, delete
# /etc/sddm.conf.d/20-kirki-vm-autologin.conf; it isn't made again.
set -u
CONF=/etc/sddm.conf.d/20-kirki-vm-autologin.conf
MARK=/var/lib/kirki-vm/autologin-set
[[ -e $MARK ]] && exit 0
[[ -e /var/lib/kirkus/setup-done ]] || { echo "First-start setup isn't finished yet."; exit 0; }
# the account made in first-start setup (the first regular one)
user=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1; exit}' /etc/passwd)
[[ -n $user ]] || { echo "No account to log in to yet."; exit 0; }
session=plasma.desktop
[[ -f /usr/share/wayland-sessions/plasma.desktop ]] || session=plasmax11.desktop
mkdir -p "${CONF%/*}" "${MARK%/*}"
printf '# Set up by kirk-vm-autologin: the kirki Mac app opens straight onto the desktop.\n[Autologin]\nUser=%s\nSession=%s\nRelogin=false\n' \
  "$user" "$session" > "$CONF"
touch "$MARK"
echo "$user is logged in automatically from now on."
