#!/bin/sh
# KInfoCenter extra info: computer model. MUST print exactly two lines.
# In the kirki Mac app, kirki runs in a virtual machine: show the Mac it runs on, as the app reports it
# (kirk-vm-agent saves that in /run/kirki/host.env).
f=${KIRK_HOST_ENV:-/run/kirki/host.env}
model=$(sed -n 's/^MAC_MODEL=//p' "$f" 2>/dev/null | head -1)
chip=$(sed -n 's/^MAC_CHIP=//p' "$f" 2>/dev/null | head -1)
if [ -n "$model" ] && [ -n "$chip" ]; then v="kirki app on a Mac ($model, $chip)"
elif [ -n "$model$chip" ]; then v="kirki app on a Mac ($model$chip)"
else v="kirki app on a Mac"; fi
printf 'Model:\n%s\n' "$(printf '%s' "$v" | tr -d '\r\n')"
