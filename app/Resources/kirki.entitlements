<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- run virtual machines with Apple's Virtualization framework -->
	<key>com.apple.security.virtualization</key>
	<true/>
	<!-- kirki's sound card can use the microphone (with the hardened runtime) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- log out of the Mac (or shut it down) when kirki shuts down, in the kirki login -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
